# ---------------------------------------------------------------------------
# agentic-infra-labs — copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# Primary provider. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent loop.
#
#   claude-opus-5    default. Strongest diagnosis on the multi-cause scenarios
#                    (scenario 02 needs the agent to find BOTH the GPU shortage
#                    and the taint mismatch — weaker models reliably find one).
#   claude-sonnet-5  cheaper. Good enough for scenarios 01 and 03-06.
#
# See VERSIONS.md for measured per-scenario cost on both.
AGENT_MODEL=claude-opus-5

# Reasoning depth for lab runs: low | medium | high | xhigh | max
# medium is the lab default — it keeps cost down without losing the multi-step
# reasoning the scenarios are built to show.
AGENT_EFFORT=medium

# ---------------------------------------------------------------------------
# Fallback provider (documented, not the canonical path — see README).
# Only needed if you run the labs with --provider openai.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
